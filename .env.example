# ══════════════════════════════════════
# Supabase Configuration
# ══════════════════════════════════════
# Dapatkan dari: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — untuk admin API (employee lookup, user management, dll)
# JANGAN expose ke client! Tidak pakai NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server-side only. Generate a random secret and set the same value in Vercel.
CRON_SECRET=generate-a-random-secret
RAPIDAPI_KEY=your-rapidapi-key-here

# ══════════════════════════════════════
# Instagram Graph API (opsional, untuk feed News di Home)
# ══════════════════════════════════════
# Lihat tutorial SETUP_INSTAGRAM.md untuk panduan lengkap
# Jika tidak diisi, bagian News akan menampilkan video YouTube Podcast

INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ══════════════════════════════════════
# Google Sheets Sync (Master Karyawan)
# ══════════════════════════════════════
# Cara: Buka spreadsheet → File → Share → Publish to web → CSV
# Salin URL-nya ke bawah ini

GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/export?format=csv&gid=0

# ══════════════════════════════════════
# Preview / Demo Mode (opsional)
# ══════════════════════════════════════
# Jika diisi, app berjalan tanpa Supabase login. Berguna untuk preview/demo.
# Development only; ignored by the server in production.
# Nilai: 'superuser' | 'administrator' | 'manager' | 'pic' | 'employee'
# Kosongkan di production!
NEXT_PUBLIC_PREVIEW_ROLE=

# Secrets for Superuser-managed integrations. Never use NEXT_PUBLIC_ for secrets.
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
