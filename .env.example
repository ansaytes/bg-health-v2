# BG-Health v2 - Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase (dari Settings > API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Sheets CSV (publish to web, format CSV)
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=0
